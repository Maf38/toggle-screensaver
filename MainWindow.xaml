<Window x:Class="ToggleScreensaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toggle Screensaver"
        Width="360" Height="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ToggleButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,0,0,0"/>
        </Style>

        <Style x:Key="TimePart" TargetType="ComboBox">
            <Setter Property="Width" Value="52"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <TabControl BorderThickness="0" Background="#F0F0F0">

        <!-- ───────── Principal ───────── -->
        <TabItem Header="Principal">
            <Grid Background="#F0F0F0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Image marmotte endormie -->
                    <Image x:Name="SleepImage"
                           Source="pack://application:,,,/sleep.png"
                           Width="80" Height="80"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- État -->
                    <TextBlock x:Name="StatusLabel"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"
                               Foreground="#555"/>

                    <!-- Prochaine bascule automatique -->
                    <TextBlock x:Name="ScheduleLabel"
                               FontSize="11.5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               Foreground="#777"/>

                    <!-- Bouton toggle -->
                    <Button x:Name="ToggleBtn"
                            Style="{StaticResource ToggleButton}"
                            Width="200"
                            Click="ToggleBtn_Click"/>

                    <TextBlock x:Name="HotkeyLabel"
                               FontSize="11.5"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Foreground="#777"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ───────── Paramètres ───────── -->
        <TabItem Header="Paramètres">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F0F0F0">
                <StackPanel Margin="18,0,18,16">

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Démarrage"/>
                    <CheckBox x:Name="StartWithWindowsCheck"
                              Content="Lancer l'application avec Windows"
                              Click="Setting_Changed"/>
                    <CheckBox x:Name="BlockOnStartCheck"
                              Content="Veille désactivée par défaut au lancement"
                              Click="Setting_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="C'est aussi l'état rétabli à la fin de la plage horaire."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Affichage"/>
                    <CheckBox x:Name="ShowInTrayCheck"
                              Content="Zone de notification (pas de bouton dans la barre des tâches)"
                              Click="Setting_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="La fenêtre se ferme dans la zone de notification ; « Quitter » est dans le menu de l'icône (clic droit)."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Plage horaire de veille automatique"/>
                    <CheckBox x:Name="ScheduleCheck"
                              Content="Réactiver la veille automatiquement sur cette plage"
                              Click="Setting_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="22,6,0,0"
                                IsEnabled="{Binding IsChecked, ElementName=ScheduleCheck}">
                        <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="StartHourBox" Style="{StaticResource TimePart}" SelectionChanged="Setting_Changed"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox x:Name="StartMinuteBox" Style="{StaticResource TimePart}" SelectionChanged="Setting_Changed"/>
                        <TextBlock Text="à" VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <ComboBox x:Name="EndHourBox" Style="{StaticResource TimePart}" SelectionChanged="Setting_Changed"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox x:Name="EndMinuteBox" Style="{StaticResource TimePart}" SelectionChanged="Setting_Changed"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                               Text="Pendant la plage (qui peut passer minuit), la veille est réactivée ; ensuite l'état par défaut revient."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Raccourci clavier global"/>
                    <CheckBox x:Name="HotkeyCheck"
                              Content="Activer/désactiver la veille avec un raccourci"
                              Click="Setting_Changed"/>
                    <TextBox x:Name="HotkeyBox"
                             Margin="22,6,0,0" Width="200" HorizontalAlignment="Left"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Padding="4,3" Cursor="Arrow"
                             ToolTip="Cliquez puis tapez la combinaison voulue"
                             IsEnabled="{Binding IsChecked, ElementName=HotkeyCheck}"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <TextBlock x:Name="HotkeyWarning"
                               Style="{StaticResource Hint}" Margin="22,4,0,0"
                               Foreground="#C62828" Visibility="Collapsed"
                               Text="Ce raccourci est déjà utilisé par une autre application. Choisissez-en un autre."/>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                               Text="Cliquez dans le champ puis tapez la combinaison (au moins Ctrl, Alt, Maj ou Win + une touche)."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mises à jour"/>
                    <TextBlock x:Name="VersionLabel" FontSize="12"/>
                    <TextBlock x:Name="UpdateStatusLabel" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="CheckUpdateBtn" Content="Rechercher" Padding="12,4"
                                Click="CheckUpdateBtn_Click"/>
                        <Button x:Name="ApplyUpdateBtn" Content="Redémarrer pour mettre à jour" Padding="12,4"
                                Margin="8,0,0,0" Visibility="Collapsed"
                                Click="ApplyUpdateBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>

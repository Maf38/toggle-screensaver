<Window x:Class="ToggleScreensaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toggle Screensaver"
        Width="320" Height="280"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ToggleButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Image marmotte endormie -->
            <Image x:Name="SleepImage"
                   Source="pack://application:,,,/sleep.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- État -->
            <TextBlock x:Name="StatusLabel"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       Foreground="#555"/>

            <!-- Bouton toggle -->
            <Button x:Name="ToggleBtn"
                    Style="{StaticResource ToggleButton}"
                    Width="200"
                    Click="ToggleBtn_Click"/>

        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms uniquement pour NotifyIcon (icône de zone de notification) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ToggleScreensaver</AssemblyName>
    <RootNamespace>ToggleScreensaver</RootNamespace>
    <ApplicationIcon>sleep.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Évite les ambiguïtés WPF / WinForms (Application, Color, MessageBox...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="sleep.png" />
    <None Include="sleep.ico" />
  </ItemGroup>

</Project>
